<h1 class="title">FRANQUIAS</h1>

<div class="franchise-container">
  <% @franchises.each do |franchise| %>
    
    <div class="franchise-card">
      <h2><%= franchise.name %></h2>

      <div class="franchise-actions">
        <%= link_to "Editar", edit_franchise_path(franchise) %>
        <%= button_to "Deletar", franchise, method: :delete %>
      </div>
    </div>

  <% end %>
</div>

<div class="add-franchise">
  <%= link_to "Nova Franquia", new_franchise_path %>
</div>