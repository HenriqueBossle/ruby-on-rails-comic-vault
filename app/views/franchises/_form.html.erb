<h1 class="form-title">Nova Franquia</h1>

<%= form_with model: franchise, html: { class: "comic-form" } do |f| %>

  <% if franchise.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(franchise.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul>
        <% franchise.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Nome da Franquia" %>
    <%= f.text_field :name, placeholder: "Ex: Marvel, DC..." %>
  </div>

  <div class="form-actions">
    <%= f.submit "Criar Franquia" %>
  </div>

<% end %>