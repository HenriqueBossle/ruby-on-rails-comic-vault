<div class="comic-show">

  <% if @comic.imageUrl.present? %>
    <img src="<%= @comic.imageUrl %>" class="comic-show-img">
  <% end %>

  <div class="comic-show-info">

    <h1><%= @comic.name %></h1>
    <p><strong>Edição:</strong> <%= @comic.issue %></p>
    <p><strong>Data:</strong> <%= @comic.publishData %></p>
    <p><strong>Páginas:</strong> <%= @comic.pageNumber %></p>
    <p><strong>Franquia:</strong> <%= @comic.franchise.name %></p>
    

    <div class="actions">
      <%= link_to "Editar", edit_comic_path(@comic), class: "btn-edit" %>
      <%= button_to "Deletar", @comic, method: :delete, class: "btn-delete" %>
    </div>

    <%= link_to "Voltar", comics_path, class: "back-link" %>
  </div>

</div>