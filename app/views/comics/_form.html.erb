<h1 class="form-title">Nova HQ</h1>

<%= form_with model: comic, html: { class: "comic-form" } do |f| %>

  <% if comic.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(comic.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul>
        <% comic.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Nome" %>
    <%= f.text_field :name %>
  </div>

  <div class="form-group">
    <%= f.label :issue, "Edição" %>
    <%= f.number_field :issue %>
  </div>

  <div class="form-group">
    <%= f.label :publishData, "Data de Publicação" %>
    <%= f.text_field :publishData %>
  </div>

  <div class="form-group">
    <%= f.label :pageNumber, "Número de Páginas" %>
    <%= f.number_field :pageNumber %>
  </div>

  <div class="form-group">
    <%= f.label :imageUrl, "URL da Imagem" %>
    <%= f.text_field :imageUrl %>
  </div>

  <div class="form-group">
    <%= f.label :franchise_id, "Franquia" %>
    <%= f.collection_select :franchise_id, Franchise.all, :id, :name, prompt: "Selecione uma franquia" %>
  </div>

  <div class="form-actions">
    <%= f.submit "Criar HQ" %>
  </div>

<% end %>