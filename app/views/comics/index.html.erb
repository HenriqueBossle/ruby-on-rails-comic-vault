<h1 class="title">MINHAS HQs</h1>

<%= form_with url: comics_path, method: :get, class: "search-form" do |form| %>
  <%= form.text_field :query, value: params[:query], placeholder: "Pesquisar HQ...", class: "search-input" %>
  <%= form.submit "Pesquisar HQ", class: "search-btn" %>
<% end %>

<div id="comics">
  <% @comics.each do |comic| %>
    <div class="comic-card">
      
      <% if comic.imageUrl.present? %>
        <img src="<%= comic.imageUrl %>" alt="comic image">
      <% end %>

      <div class="comic-info">
        <h2><%= comic.name %> #<%= comic.issue %></h2>
        <strong> <p><%= comic.franchise.name %> </p></strong> 
        <%= link_to "Ver mais", comic_path(comic) %>
   
      </div>

    </div>
  <% end %>
</div>
<div class="add-franchise">
<% if logged_in? %>
  <%= link_to "Adicionar HQ", new_comic_path %>
<% end %>
</div>
