<h1 class="title">COMICS</h1>

<div id="comics">
  <% @comics.each do |comic| %>
    <div class="comic-card">
      
      <% if comic.imageUrl.present? %>
        <img src="<%= comic.imageUrl %>" alt="comic image">
      <% end %>

      <div class="comic-info">
        <h2><%= comic.name %></h2>
        <p>Edição #<%= comic.issue %></p>
        <p><%= comic.publishData %></p>
        <p><%= comic.pageNumber %> páginas</p>
        <%= link_to "Ver mais", comic_path(comic) %>
   
      </div>

    </div>
  <% end %>
</div>
