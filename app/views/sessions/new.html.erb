<h1 class="form-title">Login</h1>

<%= form_with url: login_path, method: :post, html: { class: "comic-form" } do |f| %>

  <div class="form-group">
    <%= label_tag :email %>
    <%= text_field_tag :email, nil, placeholder: "Digite seu email" %>
  </div>

  <div class="form-group">
    <%= label_tag :password %>
    <%= password_field_tag :password, nil, placeholder: "Digite sua senha" %>
  </div>

  <div class="form-actions">
    <%= submit_tag "Entrar" %>
  </div>

  <div class="form-extra">
    <%= link_to "Criar conta", "/signup" %>
  </div>

<% end %>